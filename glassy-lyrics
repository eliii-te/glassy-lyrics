def _playerctl(*args):
    return subprocess.run(
        ["playerctl", "-p", PLAYER, *args],
        capture_output=True, text=True, timeout=2,
    )


def get_track():
    try:
        meta = _playerctl(
            "metadata", "--format",
            "{{title}}|||{{artist}}|||{{album}}|||{{mpris:length}}",
        )
        if meta.returncode != 0 or not meta.stdout.strip():
            return None
        parts = meta.stdout.strip().split("|||")
        if len(parts) != 4:
            return None
        title, artist, album, length_us = parts
        pos_raw = _playerctl("position").stdout.strip()
        status = _playerctl("status").stdout.strip()
        return {
            "title": title,
            "artist": artist,
            "album": album,
            "duration": float(length_us) / 1_000_000 if length_us else 0.0,
            "position": float(pos_raw or 0.0),
            "status": status,
        }
    except Exception:
        return None


