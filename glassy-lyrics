def _http_json(url, timeout):
    req = urllib.request.Request(url, headers={"User-Agent": f"glassy-lyrics/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def _try_spotify(track, spotify, found, result):
    if not spotify.configured or spotify._disabled:
        return
    data = spotify.fetch(track)
    parsed = parse_spotify_response(data) if data else None
    if parsed and not found.is_set():
        result["v"] = ("parsed", parsed)
        found.set()


def _try_lrclib_exact(track, found, result):
    if found.is_set():
        return
    try:
        params = urllib.parse.urlencode({
            "artist_name": track["artist"], "track_name": track["title"],
            "album_name": track["album"], "duration": int(track["duration"]),
        })
        data = _http_json(f"{LRCLIB_URL}?{params}", FETCH_TIMEOUT)
        if data.get("syncedLyrics") and not found.is_set():
            result["v"] = ("lrc", data["syncedLyrics"])
            found.set()
    except Exception:
        pass


def _try_lrclib_search(track, found, result):
    time.sleep(0.2)
    if found.is_set():
        return
    try:
        params = urllib.parse.urlencode({"q": f"{track['title']} {track['artist']}"})
        results = _http_json(f"{LRCLIB_SEARCH}?{params}", FETCH_TIMEOUT)
        for item in results:
            if item.get("syncedLyrics") and not found.is_set():
                result["v"] = ("lrc", item["syncedLyrics"])
                found.set()
                return
    except Exception:
        pass


_SYNCEDLYRICS_RUNNER = (
    "import sys, syncedlyrics\n"
    "lang = sys.argv[3] if len(sys.argv) > 3 and sys.argv[3] else None\n"
    "kw = {'providers': ['Musixmatch', 'Lrclib', 'NetEase']}\n"
    "if lang: kw['lang'] = lang\n"
    "r = syncedlyrics.search(sys.argv[1], **kw) or ''\n"
    "open(sys.argv[2], 'w', encoding='utf-8').write(r)\n"
)


def _try_syncedlyrics(track, found, result, lang=None):
    """Run syncedlyrics in a subprocess so its noisy print() statements never
    leak into our terminal rendering. `lang` is forwarded if set per-song."""
    time.sleep(2.0)
    if found.is_set():
        return
    tmp_fd, tmp_path = tempfile.mkstemp(prefix="glassy-lyrics-", suffix=".lrc")
    os.close(tmp_fd)
    try:
        # Use sys.executable, NOT "python3": the interpreter that runs this
        # script may be a pyenv/venv python where syncedlyrics is installed,
        # while the system python3 has no access to it.
        subprocess.run(
            [sys.executable, "-c", _SYNCEDLYRICS_RUNNER,
             f"{track['title']} {track['artist']}", tmp_path, lang or ""],
            capture_output=True, timeout=30,
        )
        with open(tmp_path, encoding="utf-8") as f:
            content = f.read()
        if content.strip() and not found.is_set():
            result["v"] = ("lrc", content)
            found.set()
    except Exception:
        pass
    finally:
        try:
            os.unlink(tmp_path)
        except FileNotFoundError:
            pass


def _load_local_override(track):
    """Return raw LRC text from ~/.config/glassy-lyrics/lrc/, or None.
    Matches '<Artist> - <Title>.lrc' (case-insensitive, "/" → "_")."""
    if not os.path.isdir(LRC_OVERRIDE_DIR):
        return None
    safe = lambda s: s.replace("/", "_").strip()
    target = f"{safe(track['artist'])} - {safe(track['title'])}.lrc".lower()
    try:
        for name in os.listdir(LRC_OVERRIDE_DIR):
            if name.lower() == target:
                with open(os.path.join(LRC_OVERRIDE_DIR, name), encoding="utf-8") as f:
                    return f.read()
    except OSError:
        pass
    return None


def fetch_lyrics_race(track, spotify, lang=None):
    """Fetch lyrics with word-level sources prioritized over line-level ones.

    Phase 1 starts the word-level sources (Spotify, Better Lyrics/TTML) and
    gives them a short head start. Phase 2 (line-level: LRCLIB, syncedlyrics)
    only starts if no word-level hit arrived — so a precise TTML karaoke track
    always wins over a guessed line-level one."""
    local = _load_local_override(track)
    if local and local.strip():
        return parse_lrc(local)
    found = threading.Event()
    result = {"v": None}

    def start(worker):
        threading.Thread(target=worker, daemon=True).start()

    # Phase 1 — word-level sources get a head start
    if spotify.configured:
        start(lambda: _try_spotify(track, spotify, found, result))
    start(lambda: _try_boidu(track, found, result))

    if not found.wait(timeout=1.2):
        # Phase 2 — line-level fallbacks
        start(lambda: _try_lrclib_exact(track, found, result))
        start(lambda: _try_lrclib_search(track, found, result))
        if ENABLE_FALLBACK:
            start(lambda: _try_syncedlyrics(track, found, result, lang))
        found.wait(timeout=max(1.0, RACE_TIMEOUT - 1.2))

    if not result["v"]:
        return None
    kind, data = result["v"]
    if kind == "parsed":
        return data
    return parse_lrc(data)


_TS_RE = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")


def parse_lrc(text):
    """Parse standard LRC into our 3-tuple format. Word timings stay empty
    since LRCLIB-style lyrics are line-level only."""
    lines = []
    for raw in text.splitlines():
        stamps = _TS_RE.findall(raw)
        if not stamps:
            continue
        body = _TS_RE.sub("", raw).strip()
        for mins, secs in stamps:
            ts = int(mins) * 60 + float(secs)
            lines.append((ts, body, []))
    lines.sort(key=lambda x: x[0])
    seen, out = set(), []
    for ts, body, wt in lines:
        key = (round(ts, 2), body)
        if key in seen:
            continue
        seen.add(key)
        out.append((ts, body, wt))
    return out


class LyricsCache:
    def __init__(self, spotify):
        self._lock = threading.Lock()
        self._cache = {}
        self._inflight = set()
        self._spotify = spotify

    def request(self, track, lang=None):
        key = (track["artist"], track["title"])
        with self._lock:
            if key in self._cache or key in self._inflight:
                return
            self._inflight.add(key)
        threading.Thread(target=self._worker, args=(dict(track), key, lang), daemon=True).start()

    def _worker(self, track, key, lang):
        try:
            r = fetch_lyrics_race(track, self._spotify, lang=lang)
        except Exception:
            r = None
        with self._lock:
            self._cache[key] = r if r else "MISSING"
            self._inflight.discard(key)

    def get(self, track):
        key = (track["artist"], track["title"])
        with self._lock:
            v = self._cache.get(key)
            if v == "MISSING":
                return None, "missing"
            if v is None:
                return None, "loading"
            return v, "ok"


# ──────────────────────────────────────────
# Word lookup
# ──────────────────────────────────────────

def load_song_config(track):
    """Look up per-song config from ~/.config/glassy-lyrics/offsets.json.
    Returns dict with optional keys: 'offset' (float seconds), 'lang' (e.g. 'ko').
    Keys are 'Artist|Title' (case-insensitive). Value can be a number (offset
    shorthand) or an object with 'offset'/'lang' fields."""
    try:
        with open(OFFSETS_FILE) as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {"offset": 0.0, "lang": None}
    key = f"{track['artist']}|{track['title']}".lower()
    for k, v in data.items():
        if k.lower() != key:
            continue
        if isinstance(v, (int, float)):
            return {"offset": float(v), "lang": None}
        if isinstance(v, dict):
            return {
                "offset": float(v.get("offset", 0.0) or 0.0),
                "lang": v.get("lang"),
            }
    return {"offset": 0.0, "lang": None}


def find_word(lines, position, extra_offset=0.0):
    """Real word-level lookup when timings are present (Spotify), char-weighted
    interpolation otherwise (LRCLIB)."""
    pos = position + OFFSET + extra_offset
    if not lines:
        return "", "", -1
    idx = -1
    for i, entry in enumerate(lines):
        if entry[0] <= pos:
            idx = i
        else:
            break
    if idx < 0:
        return "", "", -1
    line_start, line_text, word_timings = lines[idx]
    line_end = lines[idx + 1][0] if idx + 1 < len(lines) else line_start + 4.0
    if not line_text:
        return "", "", idx

    if word_timings:
        # Line is active but the first word's timestamp lies in the future
        # (Spotify syllable timing can start later than line_start) — nothing
        # has been sung yet, so don't prematurely highlight the first word.
        if pos < word_timings[0][0]:
            return "", "", idx
        chosen = word_timings[0][1]
        for wts, w in word_timings:
            if wts <= pos:
                chosen = w
            else:
                break
        word_clean = re.sub(r"[^\w'’-]", "", chosen, flags=re.UNICODE)
        return line_text, word_clean, idx

    # Fallback: char-weighted interpolation
    words = line_text.split()
    if not words:
        return line_text, "", idx
    line_dur = max(0.4, line_end - line_start)
    elapsed = max(0.0, pos - line_start)
    weights = [max(1, len(w)) for w in words]
    total = sum(weights)
    char_budget = elapsed * (total / line_dur)
    cumulative = 0
    word_idx = len(words) - 1
    for i, weight in enumerate(weights):
        cumulative += weight
        if cumulative > char_budget:
            word_idx = i
            break
    word = words[word_idx]
    word_clean = re.sub(r"[^\w'’-]", "", word, flags=re.UNICODE)
    return line_text, word_clean, idx


# ──────────────────────────────────────────
# Position tracking — background poller, lock-free reader
# ──────────────────────────────────────────

class TrackState:
    """Polls playerctl in a background thread so the render loop never blocks
    on subprocess calls. Position is extrapolated using a monotonic clock."""

    def __init__(self):
        self._track = None
        self._mono = 0.0
        self._pos = 0.0
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._thread = None

    def start(self):
        def loop():
            while not self._stop.is_set():
                t = get_track()
                now = time.monotonic()
                with self._lock:
                    if t:
                        # Clamp small backward jumps from Spotify's noisy reporting
                        if (self._track and self._track.get("status") == "Playing"
                                and t.get("status") == "Playing"
                                and (t["artist"], t["title"]) == (self._track["artist"], self._track["title"])):
                            extrapolated = self._pos + (now - self._mono)
                            if t["position"] < extrapolated and extrapolated - t["position"] < 0.6:
                                t["position"] = extrapolated
                        self._track = t
                        self._mono = now
                        self._pos = t["position"]
                    else:
                        self._track = None
                self._stop.wait(POLL_INTERVAL)
        self._thread = threading.Thread(target=loop, daemon=True)
        self._thread.start()

    def stop(self):
        self._stop.set()

    def current(self):
        with self._lock:
            if not self._track:
                return None
            t = dict(self._track)
            mono = self._mono
            pos = self._pos
            status = t.get("status")
        if status == "Playing":
            t["position"] = pos + (time.monotonic() - mono)
        else:
            t["position"] = pos
        return t


# ──────────────────────────────────────────
# Big-word renderer (auto-pick figlet vs blocks)
# ──────────────────────────────────────────

class BigWord:
    def __init__(self):
        self.blocks = BlockRenderer() if HAVE_PIL else None
        self._cache = {}

    def _render_at(self, word, target_rows):
        if not (self.blocks and self.blocks.font_path):
            return [word]
        return self.blocks.render(word.upper(), target_rows=target_rows) or [word]

    def lines(self, word, max_w):
        if not word:
            return [""]
        key = (word, max_w)
        cached = self._cache.get(key)
        if cached is not None:
            return cached
        result = self._render_fitted(word, max_w)
        if len(self._cache) > 300:
            self._cache.clear()
        self._cache[key] = result
        return result

    def _render_fitted(self, word, max_w):
        """Try rendering at default height; if too wide, shrink down to a
        minimum, and if it STILL overflows, split the word across multiple
        rows of block-art stacked on top of each other."""
        if not (self.blocks and self.blocks.font_path):
            return [word]
        # 1. Try default height + smaller heights until it fits horizontally
        for rows in range(BIG_HEIGHT_ROWS, 3, -1):
            r = self._render_at(word, rows)
            if not r:
                break
            if max(len(line) for line in r) <= max_w:
                return r
        # 2. Doesn't fit even at minimum size — split into chunks that do fit.
        #    Greedy: estimate, verify actual rendered width, shrink if overflow.
        full = self._render_at(word, BIG_HEIGHT_ROWS) or [word]
        full_w = max(len(line) for line in full) if full else 1
        char_w = max(1.0, full_w / max(1, len(word)))
        output = []
        remaining = word
        first = True
        while remaining:
            n = min(len(remaining), max(1, int(max_w / char_w)))
            chunk_lines = self._render_at(remaining[:n], BIG_HEIGHT_ROWS) or [remaining[:n]]
            while n > 1 and max(len(line) for line in chunk_lines) > max_w:
                n -= 1
                chunk_lines = self._render_at(remaining[:n], BIG_HEIGHT_ROWS) or [remaining[:n]]
            if not first:
                output.append("")
            output.extend(chunk_lines)
            remaining = remaining[n:]
            first = False
        return output

    def prewarm(self, lyrics, max_w):
        """Pre-render every unique word in the lyrics in a background thread.
        Pillow rendering is fast (~5ms/word) but caching avoids any glitch
        on the first time a word is shown during playback."""
        if not lyrics or not (self.blocks and self.blocks.font_path):
            return
        words = set()
        for entry in lyrics:
            line = entry[1] if len(entry) > 1 else ""
            for w in line.split():
                clean = re.sub(r"[^\w'’-]", "", w, flags=re.UNICODE)
                if clean:
                    words.add(clean.upper())
        def warm():
            for w in words:
                self.lines(w, max_w)
        threading.Thread(target=warm, daemon=True).start()


# ──────────────────────────────────────────
# Frame rendering — diff-aware, no flicker
# ──────────────────────────────────────────

def fmt_time(s):
    s = max(0, int(s))
    return f"{s // 60}:{s % 60:02d}"


def progress_bar(pos, dur, w):
    if dur <= 0:
        return ""
    frac = max(0.0, min(1.0, pos / dur))
    fill = int(frac * w)
    return "▰" * fill + "▱" * (w - fill)


class Frame:
    def __init__(self, big):
        self.big = big
        self.last_word = None
        self.last_footer = None
        self.last_size = (0, 0)
        self.big_geom = None  # (top_row, num_rows)

    def render(self, word, footer, term_w, term_h):
        out = []
        size_changed = (term_w, term_h) != self.last_size
        if size_changed:
            out.append(CLEAR)
            self.last_size = (term_w, term_h)
            self.last_word = self.last_footer = None
            self.big_geom = None

        if word != self.last_word or size_changed:
            big_lines = self.big.lines(word, term_w)
            big_h = len(big_lines)
            if self.big_geom:
                ptop, prows = self.big_geom
                for r in range(ptop, ptop + prows):
                    out.append(f"\x1b[{r};1H{ERASE_LINE}")
            # Vertical center, leaving 1 row for the footer at the bottom
            top = max(2, (term_h - big_h - 1) // 2)
            for i, ln in enumerate(big_lines):
                out.append(f"\x1b[{top + i};1H{ERASE_LINE}{BOLD}{WHITE}{center_pad(ln, term_w)}{RESET}")
            self.big_geom = (top, big_h)

        if footer != self.last_footer or size_changed:
            out.append(f"\x1b[{term_h};1H{ERASE_LINE}{DIM}{center_pad(truncate_vis(footer, term_w - 4), term_w)}{RESET}")
            self.last_footer = footer

        self.last_word = word
        if out:
            out.append(HOME)
            sys.stdout.write("".join(out))
            sys.stdout.flush()


# ──────────────────────────────────────────
# Main
# ──────────────────────────────────────────

_RUNNING = True


def cleanup(*_):
    global _RUNNING
    _RUNNING = False
    sys.stdout.write(SHOW + CLEAR)
    sys.stdout.flush()


def _silence_stderr():
    """Send everything that any code (Python, libs, subprocesses) writes to
    stderr/fd 2 to /dev/null so it can never corrupt the rendered display.
    Set GLASSY_LYRICS_DEBUG=1 to keep stderr visible for debugging."""
    if os.environ.get("GLASSY_LYRICS_DEBUG") == "1":
        return
    try:
        devnull_fd = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull_fd, 2)
        os.close(devnull_fd)
        sys.stderr = open(os.devnull, "w", buffering=1)
    except Exception:
        pass


def main():
    args = sys.argv[1:]
    if "--version" in args or "-V" in args:
        print(f"glassy-lyrics {VERSION}")
        sys.exit(0)
    if "--help" in args or "-h" in args:
        print(HELP_TEXT)
        sys.exit(0)
    _silence_stderr()
    sys.stdout.write(HIDE + CLEAR)
    sys.stdout.flush()
    signal.signal(signal.SIGINT, lambda *a: (cleanup(), sys.exit(0)))
    signal.signal(signal.SIGTERM, lambda *a: (cleanup(), sys.exit(0)))

    state = TrackState()
    state.start()
    spotify = SpotifyLyrics()
    cache = LyricsCache(spotify)
    big = BigWord()
    frame = Frame(big)

    last_track_id = None
    last_lyrics_state = None
    song_offset = 0.0
    song_lang = None

    try:
        while _RUNNING:
            term = shutil.get_terminal_size((80, 24))
            tw, th = term.columns, term.lines
            track = state.current()

            if not track:
                frame.render("",
                             "No track playing — playerctl: no active player",
                             tw, th)
                time.sleep(0.3)
                continue

            tid = (track["artist"], track["title"])
            if tid != last_track_id:
                last_track_id = tid
                last_lyrics_state = None
                cfg = load_song_config(track)
                song_offset = cfg["offset"]
                song_lang = cfg["lang"]
                cache.request(track, lang=song_lang)

            lyrics, status = cache.get(track)
            if status != last_lyrics_state:
                last_lyrics_state = status
                if status == "ok" and lyrics:
                    big.prewarm(lyrics, tw)

            bar = progress_bar(track["position"], track["duration"], 24)
            time_part = f"{fmt_time(track['position'])} / {fmt_time(track['duration'])}"
            track_label = f"{track['artist']} — {track['title']}"

            if status == "loading":
                footer = f"{track_label}    Loading lyrics …    {bar}  {time_part}"
                frame.render("", footer, tw, th)
            elif status == "missing":
                footer = f"{track_label}    No synced lyrics found    {bar}  {time_part}"
                frame.render("", footer, tw, th)
            else:
                _, word, _ = find_word(lyrics, track["position"], extra_offset=song_offset)
                offset_marker = f"  Δ{song_offset:+.1f}s" if song_offset else ""
                footer = f"{track_label}    {bar}  {time_part}{offset_marker}"
                frame.render(word, footer, tw, th)

            time.sleep(1.0 / RENDER_HZ)
    finally:
        state.stop()
        cleanup()


if __name__ == "__main__":
    main()
