def _glassy_log(exc):
    try:
        import os, traceback
        p = os.path.expanduser("~/.cache/glassy-lyrics-patch.log")
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "a") as f:
            f.write("".join(traceback.format_exception(type(exc), exc, exc.__traceback__)))
    except Exception:
        pass

def _glassy_cell_k():
    import os, struct, fcntl, termios
    env = os.environ.get("GLASSY_CELL_ASPECT")
    if env:
        try:
            return float(env)
        except ValueError:
            pass
    for fd in (1, 0, 2):
        try:
            r, c, xp, yp = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
            if r and c and xp and yp:
                return min(1.3, max(0.8, (yp / r) / (2 * (xp / c))))
        except Exception:
            continue
    return 1.0

_GLASSY_DEFAULT_BLOCKS = "quad"

def _glassy_blocks_hq(text, font_path, rows, max_cols, k, mode="half", ss=8, thr=0.5):
    from PIL import Image, ImageDraw, ImageFont
    box = getattr(Image, "Resampling", Image).BOX
    quad = (mode == "quad")
    target_px = max(2, rows * 2)
    S = target_px * ss
    f0 = ImageFont.truetype(font_path, S)
    cap0 = max(1, -f0.getbbox("H", anchor="ls")[1])
    font = ImageFont.truetype(font_path, max(8, round(S * S / cap0)))
    cap = max(1, -font.getbbox("H", anchor="ls")[1])
    l, t, r, b = font.getbbox(text, anchor="ls")
    pad = ss * 2
    top_ext = max(cap, -t)
    im = Image.new("L", ((r - l) + 2 * pad, top_ext + max(0, b) + 2 * pad), 0)
    base = pad + top_ext
    ImageDraw.Draw(im).text((pad - l, base), text, font=font, fill=255, anchor="ls")
    ink = im.getbbox()
    if not ink:
        return [""] * rows
    top = base - cap
    if ink[1] < top - cap * 0.12:
        top = ink[1]
    bottom = base
    if ink[3] > base + cap * 0.12:
        bottom = ink[3]
    im = im.crop((ink[0], max(0, top), ink[2], bottom))
    w, h = im.size
    f = target_px / cap
    sw = max(1, round(w * f * (2 * k if quad else k)))
    sh = max(2, round(h * f))
    limit = max_cols * (2 if quad else 1) if max_cols else 0
    if limit and sw > limit:
        sh = max(2, round(sh * limit / sw))
        sw = limit
    if quad and sw % 2:
        sw += 1
    if sh % 2:
        sh += 1
    px = im.resize((sw, sh), box).load()
    on = lambda x, y: px[x, y] / 255 >= thr
    out = []
    if quad:
        q = " ▘▝▀▖▌▞▛▗▚▐▜▄▙▟█"
        for y in range(0, sh, 2):
            out.append("".join(
                q[on(x, y) + 2 * on(x + 1, y) + 4 * on(x, y + 1) + 8 * on(x + 1, y + 1)]
                for x in range(0, sw, 2)).rstrip())
    else:
        for y in range(0, sh, 2):
            line = []
            for x in range(sw):
                u, d = on(x, y), on(x, y + 1)
                line.append("█" if u and d else "▀" if u else "▄" if d else " ")
            out.append("".join(line).rstrip())
    return out

def _glassy_render_patched(self, legacy, args, kwargs, ref):
    import inspect, os, shutil
    if isinstance(ref, str):
        lines, kind = ref.split("\n"), "s"
    elif isinstance(ref, (list, tuple)) and all(isinstance(x, str) for x in ref):
        lines, kind = list(ref), "l" if isinstance(ref, list) else "t"
    else:
        return ref
    if any("\x1b" in x for x in lines):
        return ref
    ba = inspect.signature(legacy).bind(*args, **kwargs)
    ba.apply_defaults()
    bound = ba.arguments
    text = bound.get("text")
    if not isinstance(text, str):
        text = next((v for v in bound.values() if isinstance(v, str)), None)
    if not text or not text.strip() or lines == [text]:
        return ref
    font = getattr(self, "font_path", None)
    if not (isinstance(font, str) and os.path.exists(font)):
        font = "/usr/share/fonts/google-noto/NotoSans-CondensedBlack.ttf"
        if not os.path.exists(font):
            return ref
    rows = bound.get("target_rows")
    if not isinstance(rows, int) or rows < 1:
        rows = len(lines)
    mode = os.environ.get("GLASSY_BLOCKS", _GLASSY_DEFAULT_BLOCKS)
    if mode not in ("half", "quad"):
        mode = _GLASSY_DEFAULT_BLOCKS
    maxc = shutil.get_terminal_size((100, 30)).columns - 4
    out = _glassy_blocks_hq(" ".join(text.split()), font, rows, maxc, _glassy_cell_k(), mode)
    wmax = max((len(x) for x in out), default=0)
    out = ["  " + x.ljust(wmax) for x in out]  # filas del mismo ancho: el marco no las desplaza
    return "\n".join(out) if kind == "s" else (out if kind == "l" else tuple(out))




class BlockRenderer:
    def __init__(self):
        self.font_path = None
        for fp in PIL_FONTS_BOLD:
            if os.path.exists(fp):
                self.font_path = fp
                break
        self._font_cache = {}
        self.cache = {}

    def _font(self, size):
        if size not in self._font_cache:
            self._font_cache[size] = ImageFont.truetype(self.font_path, size)
        return self._font_cache[size]

    def render(self, *args, **kwargs):
        ref = self._render_legacy(*args, **kwargs)
        try:
            return _glassy_render_patched(self, self._render_legacy, args, kwargs, ref)
        except Exception as exc:
            _glassy_log(exc)
            return ref

    def _render_legacy(self, text, target_rows=8):
        if not text or not self.font_path or not HAVE_PIL:
            return [text]
        key = (text, target_rows)
        if key in self.cache:
            return self.cache[key]
        try:
            target_px = target_rows * 2
            font = self._font(int(target_px * 0.85))
            bbox = font.getbbox(text)
            text_h = bbox[3] - bbox[1]
            w = bbox[2] - bbox[0] + 4
            h = target_px
            img = Image.new("L", (w, h), 0)
            draw = ImageDraw.Draw(img)
            draw.text(
                (2 - bbox[0], (h - text_h) // 2 - bbox[1]),
                text, font=font, fill=255,
            )
            px = img.load()
            rows = []
            for y in range(0, h, 2):
                row = []
                for x in range(w):
                    top = px[x, y] > 128
                    bot = px[x, y + 1] > 128 if y + 1 < h else False
                    if top and bot:
                        row.append("█")
                    elif top:
                        row.append("▀")
                    elif bot:
                        row.append("▄")
                    else:
                        row.append(" ")
                rows.append("".join(row).rstrip())
            # Strip leading empty rows
            while rows and not rows[0].strip():
                rows.pop(0)
            while rows and not rows[-1].strip():
                rows.pop()
            result = rows or [text]
        except Exception:
            result = [text]
        if len(self.cache) > 400:
            self.cache.clear()
        self.cache[key] = result
        return result


# ──────────────────────────────────────────
# Width-aware helpers
# ──────────────────────────────────────────

def char_width(c):
    o = ord(c)
    if o < 0x20:
        return 0
    if (0x1100 <= o <= 0x115F or 0x2E80 <= o <= 0x303E or 0x3041 <= o <= 0x33FF
            or 0x3400 <= o <= 0x4DBF or 0x4E00 <= o <= 0x9FFF
            or 0xA000 <= o <= 0xA4CF or 0xAC00 <= o <= 0xD7A3
            or 0xF900 <= o <= 0xFAFF or 0xFE30 <= o <= 0xFE4F
            or 0xFF00 <= o <= 0xFF60 or 0xFFE0 <= o <= 0xFFE6
            or 0x20000 <= o <= 0x2FFFD or 0x30000 <= o <= 0x3FFFD):
        return 2
    return 1


def vis_width(s):
    return sum(char_width(c) for c in s)


def truncate_vis(s, max_w):
    out, w = [], 0
    for c in s:
        cw = char_width(c)
        if w + cw > max_w:
            out.append("…")
            return "".join(out)
        out.append(c)
        w += cw
    return "".join(out)


def center_pad(s, total_w):
    w = vis_width(s)
    if w >= total_w:
        return s
    left = (total_w - w) // 2
    right = total_w - w - left
    return " " * left + s + " " * right


