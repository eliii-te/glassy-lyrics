# Spotify lyrics (word-level when available)
# ──────────────────────────────────────────

class SpotifyLyrics:
    """Fetches lyrics directly from Spotify's web-player API using the user's
    sp_dc browser cookie. When the song returns LINE_AND_WORD_SYNCED, we get
    real per-word timestamps."""

    def __init__(self):
        self.sp_dc = self._load()
        self._token = None
        self._token_expires = 0.0
        self._lock = threading.Lock()
        self._disabled = False  # set if Spotify rejects auth (TOTP/ToS block)

    @staticmethod
    def _load():
        try:
            with open(SP_DC_FILE) as f:
                v = f.read().strip()
                return v or None
        except (FileNotFoundError, IOError):
            return None

    @property
    def configured(self):
        return bool(self.sp_dc)

    def _refresh_token(self):
        if not self.sp_dc or self._disabled:
            return None
        req = urllib.request.Request(
            SPOTIFY_TOKEN_URL,
            headers={
                "Cookie": f"sp_dc={self.sp_dc}",
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) glassy-lyrics",
                "App-Platform": "WebPlayer",
                "Accept-Language": "en",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=8) as r:
                data = json.loads(r.read())
        except urllib.error.HTTPError as e:
            # 400/403 = Spotify blocks third-party access (TOTP / ToS).
            # Disable for this session to stop hammering their endpoint.
            if e.code in (400, 403):
                self._disabled = True
            return None
        except Exception:
            return None
        if not data or data.get("isAnonymous"):
            return None
        self._token = data.get("accessToken")
        ms = data.get("accessTokenExpirationTimestampMs", 0)
        self._token_expires = ms / 1000 if ms else time.time() + 1800
        return self._token

    def _token_now(self):
        with self._lock:
            if self._token and time.time() < self._token_expires - 60:
                return self._token
            return self._refresh_token()

    @staticmethod
    def _track_id(track):
        # playerctl gives mpris:trackid like spotify:track:XYZ or /com/spotify/track/XYZ
        try:
            raw = subprocess.run(
                ["playerctl", "-p", PLAYER, "metadata", "mpris:trackid"],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip()
            return raw.rsplit("/", 1)[-1].rsplit(":", 1)[-1] or None
        except Exception:
            return None

    def fetch(self, track):
        if not self.configured:
            return None
        tid = self._track_id(track)
        if not tid:
            return None
        token = self._token_now()
        if not token:
            return None
        url = SPOTIFY_LYRICS_URL.format(tid)
        req = urllib.request.Request(
            url,
            headers={
                "Authorization": f"Bearer {token}",
                "App-Platform": "WebPlayer",
                "User-Agent": "Mozilla/5.0",
                "Accept": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=8) as r:
                return json.loads(r.read())
        except urllib.error.HTTPError as e:
            if e.code == 401:
                with self._lock:
                    self._token = None
                token = self._token_now()
                if not token:
                    return None
                req.add_header("Authorization", f"Bearer {token}")
                try:
                    with urllib.request.urlopen(req, timeout=8) as r:
                        return json.loads(r.read())
                except Exception:
                    return None
            return None
        except Exception:
            return None


def parse_spotify_response(data):
    """Convert Spotify lyrics JSON into our internal format:
    list of (line_ts, line_text, [(word_ts, word), ...])"""
    lyrics = (data or {}).get("lyrics") or {}
    sync_type = lyrics.get("syncType", "")
    if sync_type == "UNSYNCED":
        return None
    raw_lines = lyrics.get("lines") or []
    out = []
    for line in raw_lines:
        try:
            ts = int(line.get("startTimeMs") or 0) / 1000.0
        except Exception:
            continue
        text = (line.get("words") or "").strip()
        if not text or text == "♪":
            out.append((ts, "", []))
            continue
        word_timings = []
        syllables = line.get("syllables") or []
        if syllables and sync_type == "LINE_AND_WORD_SYNCED":
            words = text.split()
            # Prefix-sum of syllable char positions so we can find the syllable
            # active at a given char position in O(1).
            syl_starts = [0]
            for s in syllables:
                syl_starts.append(syl_starts[-1] + int(s.get("numChars", 1)))
            char_pos = 0
            syl_idx = 0
            for word in words:
                while syl_idx + 1 < len(syllables) and syl_starts[syl_idx + 1] <= char_pos:
                    syl_idx += 1
                try:
                    wt = int(syllables[syl_idx]["startTimeMs"]) / 1000.0
                except Exception:
                    wt = ts
                word_timings.append((wt, word))
                char_pos += len(word) + 1
        out.append((ts, text, word_timings))
    out.sort(key=lambda x: x[0])
    # Drop fully empty list
    if not any(t for _, t, _ in out):
        return None
    return out


# ──────────────────────────────────────────
# TTML (Better Lyrics API) — word/syllable-level timing
# ──────────────────────────────────────────

_TT_NS = re.compile(r"\s+xmlns(?::\w+)?=\"[^\"]*\"")
_TT_TAG = re.compile(r"(</?)([\w.-]+):([\w.-]+)")
_TT_ATTR = re.compile(r"\s+([\w.-]+):([\w.-]+)=\"")


def _strip_ttml_ns(xml_text):
    """Strip XML namespace declarations and prefixes (tags AND attributes) so
    ElementTree can parse Apple-style TTML without namespace gymnastics."""
    xml_text = _TT_NS.sub("", xml_text)
    xml_text = _TT_TAG.sub(lambda m: m.group(1) + m.group(3), xml_text)
    xml_text = _TT_ATTR.sub(lambda m: f" {m.group(2)}=\"", xml_text)
    return xml_text


def _tt_time(v):
    """TTML timestamps: '18.234' (seconds) or '00:00:18.234' or '3:53.713'."""
    if v is None:
        return None
    v = v.strip()
    if not v:
        return None
    try:
        parts = v.split(":")
        if len(parts) == 3:
            h, m, s = parts
            return int(h) * 3600 + int(m) * 60 + float(s)
        if len(parts) == 2:
            m, s = parts
            return int(m) * 60 + float(s)
        return float(v)
    except (ValueError, TypeError):
        return None


def parse_ttml(xml_text):
    """Parse Apple-style TTML (as served by the Better Lyrics API / used by
    Spicy Lyrics & friends) into our internal format:
    list of (line_ts, line_text, [(word_ts, word), ...]).
    Handles both itunes:timing="Word" (every <span> is a word) and
    itunes:timing="Syllable" (group consecutive syllables into words).
    Falls back to <p begin> line times when no word spans exist."""
    import xml.etree.ElementTree as ET
    try:
        root = ET.fromstring(_strip_ttml_ns(xml_text))
    except Exception:
        return None
    timing = (root.get("timing") or "Word").lower()
    out = []
    try:
        for p in root.iter("p"):
            p_ts = _tt_time(p.get("begin"))
            if p_ts is None:
                continue
            spans = []
            for sp in p.iter("span"):
                wts = _tt_time(sp.get("begin"))
                text = "".join(sp.itertext())  # keep raw: syllable mode needs
                                                 # trailing spaces as word delimiters
                if wts is not None and text.strip():
                    spans.append((wts, text))
            if not spans:
                body = "".join(p.itertext()).strip()
                if body:
                    out.append((p_ts, body, []))
                continue
            if timing == "syllable":
                # group syllables into words: a word boundary is a space that
                # ends a syllable's text (Apple puts the trailing space on the
                # last syllable of each word)
                words = []
                cur = ""
                cur_ts = None
                for wts, text in spans:
                    if cur_ts is None:
                        cur_ts = wts
                    cur += text
                    while " " in cur:
                        idx = cur.index(" ")
                        piece = cur[:idx]
                        if piece:
                            words.append((cur_ts, piece))
                        cur = cur[idx + 1:]
                        cur_ts = None
                if cur.strip():
                    words.append((cur_ts or spans[-1][0], cur.strip()))
            else:
                words = [(ts, t.strip()) for ts, t in spans]
            words = [(ts, w) for ts, w in words if w]
            if not words:
                continue
            line_text = " ".join(w for _, w in words)
            out.append((p_ts, line_text, words))
    except Exception:
        return None
    out.sort(key=lambda x: x[0])
    if not any(t for _, t, _ in out):
        return None
    return out


def _try_boidu(track, found, result):
    """Better Lyrics API (lyrics-api.boidu.dev) — the same TTML word/syllable
    dataset Spicy Lyrics (Spicetify) renders. Public, free for cached tracks;
    optional X-API-Key via GLASSY_LYRICS_BOIDU_KEY for uncached queries."""
    time.sleep(0.05)
    if found.is_set():
        return
    try:
        params = urllib.parse.urlencode({
            "s": track["title"],
            "a": track["artist"],
            "al": track["album"],
            "d": int(track["duration"]),
        })
        headers = {"User-Agent": f"glassy-lyrics/{VERSION}"}
        key = os.environ.get("GLASSY_LYRICS_BOIDU_KEY", "").strip()
        if key:
            headers["X-API-Key"] = key
        req = urllib.request.Request(f"{BOIDU_URL}?{params}", headers=headers)
        with urllib.request.urlopen(req, timeout=8) as r:
            data = json.loads(r.read())
        ttml = (data or {}).get("ttml")
        if ttml and not found.is_set():
            parsed = parse_ttml(ttml)
            if parsed:
                result["v"] = ("parsed", parsed)
                found.set()
    except Exception:
        pass


