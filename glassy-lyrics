def _http_json(url, timeout):
    req = urllib.request.Request(url, headers={"User-Agent": f"glassy-lyrics/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def _try_spotify(track, spotify, found, result):
    if not spotify.configured or spotify._disabled:
        return
    data = spotify.fetch(track)
    parsed = parse_spotify_response(data) if data else None
    if parsed and not found.is_set():
        result["v"] = ("parsed", parsed)
        found.set()


def _try_lrclib_exact(track, found, result):
    if found.is_set():
        return
    try:
        params = urllib.parse.urlencode({
            "artist_name": track["artist"], "track_name": track["title"],
            "album_name": track["album"], "duration": int(track["duration"]),
        })
        data = _http_json(f"{LRCLIB_URL}?{params}", FETCH_TIMEOUT)
        if data.get("syncedLyrics") and not found.is_set():
            result["v"] = ("lrc", data["syncedLyrics"])
            found.set()
    except Exception:
        pass


def _try_lrclib_search(track, found, result):
    time.sleep(0.2)
    if found.is_set():
        return
    try:
        params = urllib.parse.urlencode({"q": f"{track['title']} {track['artist']}"})
        results = _http_json(f"{LRCLIB_SEARCH}?{params}", FETCH_TIMEOUT)
        for item in results:
            if item.get("syncedLyrics") and not found.is_set():
                result["v"] = ("lrc", item["syncedLyrics"])
                found.set()
                return
    except Exception:
        pass


_SYNCEDLYRICS_RUNNER = (
    "import sys, syncedlyrics\n"
    "lang = sys.argv[3] if len(sys.argv) > 3 and sys.argv[3] else None\n"
    "kw = {'providers': ['Musixmatch', 'Lrclib', 'NetEase']}\n"
    "if lang: kw['lang'] = lang\n"
    "r = syncedlyrics.search(sys.argv[1], **kw) or ''\n"
    "open(sys.argv[2], 'w', encoding='utf-8').write(r)\n"
)


def _try_syncedlyrics(track, found, result, lang=None):
    """Run syncedlyrics in a subprocess so its noisy print() statements never
    leak into our terminal rendering. `lang` is forwarded if set per-song."""
    time.sleep(2.0)
    if found.is_set():
        return
    tmp_fd, tmp_path = tempfile.mkstemp(prefix="glassy-lyrics-", suffix=".lrc")
    os.close(tmp_fd)
    try:
        # Use sys.executable, NOT "python3": the interpreter that runs this
        # script may be a pyenv/venv python where syncedlyrics is installed,
        # while the system python3 has no access to it.
        subprocess.run(
            [sys.executable, "-c", _SYNCEDLYRICS_RUNNER,
             f"{track['title']} {track['artist']}", tmp_path, lang or ""],
            capture_output=True, timeout=30,
        )
        with open(tmp_path, encoding="utf-8") as f:
            content = f.read()
        if content.strip() and not found.is_set():
            result["v"] = ("lrc", content)
            found.set()
    except Exception:
        pass
    finally:
        try:
            os.unlink(tmp_path)
        except FileNotFoundError:
            pass


def _load_local_override(track):
    """Return raw LRC text from ~/.config/glassy-lyrics/lrc/, or None.
    Matches '<Artist> - <Title>.lrc' (case-insensitive, "/" → "_")."""
    if not os.path.isdir(LRC_OVERRIDE_DIR):
        return None
    safe = lambda s: s.replace("/", "_").strip()
    target = f"{safe(track['artist'])} - {safe(track['title'])}.lrc".lower()
    try:
        for name in os.listdir(LRC_OVERRIDE_DIR):
            if name.lower() == target:
                with open(os.path.join(LRC_OVERRIDE_DIR, name), encoding="utf-8") as f:
                    return f.read()
    except OSError:
        pass
    return None


def fetch_lyrics_race(track, spotify, lang=None):
    """Fetch lyrics with word-level sources prioritized over line-level ones.

    Phase 1 starts the word-level sources (Spotify, Better Lyrics/TTML) and
    gives them a short head start. Phase 2 (line-level: LRCLIB, syncedlyrics)
    only starts if no word-level hit arrived — so a precise TTML karaoke track
    always wins over a guessed line-level one."""
    local = _load_local_override(track)
    if local and local.strip():
        return parse_lrc(local)
    found = threading.Event()
    result = {"v": None}

    def start(worker):
        threading.Thread(target=worker, daemon=True).start()

    # Phase 1 — word-level sources get a head start
    if spotify.configured:
        start(lambda: _try_spotify(track, spotify, found, result))
    start(lambda: _try_boidu(track, found, result))

    if not found.wait(timeout=1.2):
        # Phase 2 — line-level fallbacks
        start(lambda: _try_lrclib_exact(track, found, result))
        start(lambda: _try_lrclib_search(track, found, result))
        if ENABLE_FALLBACK:
            start(lambda: _try_syncedlyrics(track, found, result, lang))
        found.wait(timeout=max(1.0, RACE_TIMEOUT - 1.2))

    if not result["v"]:
        return None
    kind, data = result["v"]
    if kind == "parsed":
        return data
    return parse_lrc(data)


_TS_RE = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")


def parse_lrc(text):
    """Parse standard LRC into our 3-tuple format. Word timings stay empty
    since LRCLIB-style lyrics are line-level only."""
    lines = []
    for raw in text.splitlines():
        stamps = _TS_RE.findall(raw)
        if not stamps:
            continue
        body = _TS_RE.sub("", raw).strip()
        for mins, secs in stamps:
            ts = int(mins) * 60 + float(secs)
            lines.append((ts, body, []))
    lines.sort(key=lambda x: x[0])
    seen, out = set(), []
    for ts, body, wt in lines:
        key = (round(ts, 2), body)
        if key in seen:
            continue
        seen.add(key)
        out.append((ts, body, wt))
    return out


class LyricsCache:
    def __init__(self, spotify):
        self._lock = threading.Lock()
        self._cache = {}
        self._inflight = set()
        self._spotify = spotify

    def request(self, track, lang=None):
        key = (track["artist"], track["title"])
        with self._lock:
            if key in self._cache or key in self._inflight:
                return
            self._inflight.add(key)
        threading.Thread(target=self._worker, args=(dict(track), key, lang), daemon=True).start()

    def _worker(self, track, key, lang):
        try:
            r = fetch_lyrics_race(track, self._spotify, lang=lang)
        except Exception:
            r = None
        with self._lock:
            self._cache[key] = r if r else "MISSING"
            self._inflight.discard(key)

    def get(self, track):
        key = (track["artist"], track["title"])
        with self._lock:
            v = self._cache.get(key)
            if v == "MISSING":
                return None, "missing"
            if v is None:
                return None, "loading"
            return v, "ok"


